# Werte aus Supabase: Projekt -> Connect -> Framework Next.js (App Router)
# Datei nach .env.local kopieren und Werte eintragen.
# Dieselben Variablen auch im Vercel Projekt unter Settings -> Environment Variables anlegen.
NEXT_PUBLIC_SUPABASE_URL=https://oywevnfohukkftqarknb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# KI Anreicherung (serverseitig, landet nie im Browser)
# Schluessel erstellen unter https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Anbieter und Modell wechseln, ohne Code anzufassen
# AI_PROVIDER=anthropic   (oder: openai, dann OPENAI_API_KEY und OPENAI_MODEL setzen)
# AI_MODEL=claude-opus-5
